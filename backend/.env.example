# Copy these variable names into backend/.env and fill them from your Supabase project.
# Keep SUPABASE_SECRET_KEY on the backend. Never add it to frontend/.env or source control.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Daily market data refresh: comma-separated tickers, every 6 hours by default.
MARKET_DATA_REFRESH_ENABLED=true
MARKET_DATA_REFRESH_MINUTES=360
MARKET_DATA_SYMBOLS=AAPL

# Cache repeated provider requests for 15 minutes (0 disables OHLCV caching).
MARKET_DATA_CACHE_TTL_SECONDS=900

# Walk-forward evaluation defaults to these symbols at GET /api/evaluate.
# Override per request with /api/evaluate?symbols=AAPL,MSFT,NVDA.
EVALUATION_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL
# Optional XGBoost comparison; disabled by default to keep evaluation runs lean.
EVALUATION_INCLUDE_XGBOOST=false

# Hybrid backtests compare fixed and adaptive signals; fixed remains default.
# Request an explicit alternative with /api/backtest/AAPL/hybrid?mode=adaptive.
HYBRID_BACKTEST_MODE=fixed
ADAPTIVE_ENSEMBLE_MIN_WEIGHT=0.05
ADAPTIVE_ENSEMBLE_MAX_WEIGHT=0.80
ADAPTIVE_ENSEMBLE_TEMPERATURE=8.0
ADAPTIVE_MIN_VALIDATION_SAMPLES=20
ADAPTIVE_MIN_REGIME_SAMPLES=20
